{
  "name": "repopulse",
  "version": "0.1.0",
  "description": "Check your repo's pulse. Fix it before it dies.",
  "type": "module",
  "bin": {
    "repopulse": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github",
    "repository",
    "health",
    "audit",
    "cli",
    "readme",
    "badge"
  ],
  "author": "RepoPulse contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScovilDev/RepoPulse.git"
  },
  "bugs": {
    "url": "https://github.com/ScovilDev/RepoPulse/issues"
  },
  "homepage": "https://github.com/ScovilDev/RepoPulse#readme",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
